FROM python:3.11-slim

# Prevent .pyc files + unbuffered logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    default-libmysqlclient-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app
COPY . .

# Runs the Redis Streams consumer group -> interactions table pipeline
# (PR-B4). Deliberately not launched from app/main.py's FastAPI process --
# see app/workers/interaction_consumer.py's module docstring for why.
CMD ["python", "-m", "app.workers.interaction_consumer"]
